# Environment
ENVIRONMENT=production

# Database URL
# Development (SQLite):
# DATABASE_URL=sqlite:///./intelligence_tool.db
# Production (PostgreSQL):
DATABASE_URL=postgresql://user:password@hostname:5432/mapintel_db

# AI Provider API Keys (Server-side only - never exposed to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GROK_API_KEY=your_grok_api_key_here

# Production CORS & Frontend Configuration
# Comma-separated or single domain
FRONTEND_URL=https://your-mapintel-app.vercel.app

# Server Port
PORT=8000

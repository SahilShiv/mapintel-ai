# Database Configuration
# Default is SQLite for instant zero-dependency local dev/eval.
# For production (PostgreSQL/Supabase/Render/Railway):
# DATABASE_URL=postgresql://user:password@hostname:5432/dbname
DATABASE_URL=sqlite:///./intelligence_tool.db

# AI Provider 1: Google Gemini (Primary)
GEMINI_API_KEY=

# AI Provider 2: xAI Grok or OpenAI-compatible endpoint (Secondary)
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1

# Default AI Provider ("gemini" or "grok")
DEFAULT_AI_PROVIDER=gemini

# Scraper Settings
SCRAPER_HEADLESS=true
SCRAPER_TIMEOUT=15

# Frontend Environment Variables (Configure in Vercel Dashboard)
# In production, set this to your deployed Python FastAPI backend URL
VITE_API_BASE_URL=https://your-backend-service.onrender.com
VITE_API_URL=https://your-backend-service.onrender.com/api

# Backend URLs & CORS
FRONTEND_URL=https://your-app.vercel.app
